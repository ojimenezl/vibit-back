# Variables que debes configurar en Railway (Settings → Variables)

PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/vibit?appName=VibitDB
JWT_SECRET=pon_un_secreto_largo_y_aleatorio
JWT_EXPIRES_IN=30d
# * = permitir todos (útil al inicio). Luego restringe:
# CORS_ORIGIN=https://tu-front.vercel.app,http://localhost:5173
CORS_ORIGIN=*

# Firebase Admin (elige UNA opción):
# A) Ruta al JSON de service account (local, ya está en secrets/):
FIREBASE_CREDENTIALS_PATH=./secrets/firebase-adminsdk.json
# B) JSON completo en una sola línea (Railway) — copiar desde:
#    vibit-back/secrets/FIREBASE_SERVICE_ACCOUNT.railway.txt
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Google Sign-In (Web client ID de Google Cloud → Credenciales OAuth)
GOOGLE_CLIENT_ID=xxxxx-xxxx.apps.googleusercontent.com
# En ese cliente Web (Google Cloud → Credenciales), Authorized JavaScript origins debe incluir:
#   https://vibit-back-production.up.railway.app
# Sin eso, el botón de Google en /api/auth/google/mobile no funciona en Android.

# Aviso soft de actualización (Android versionCode mínimo).
# 0 = desactivado. Ej: 7 → solo apps con versionCode < 7 ven el popup.
MIN_ANDROID_VERSION_CODE=0
# PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.vibit.app
# UPDATE_MESSAGE=Hay una nueva versión de Vibit...
